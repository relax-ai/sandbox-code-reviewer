# cp .env.example .env   then fill in api_key (the only REQUIRED value).

# --- relaxAI -----------------------------------------------------------------
endpoint=api.beta.relax.ai
# REQUIRED. One key drives both the sandbox API and the model the agent uses.
api_key=
model_id=DeepSeek-V41-Flash

# --- The demo repo -----------------------------------------------------------
# The public repo whose PRs the agent reviews. Attendees: leave as is.
target_repo=bennorris123/sandbox-workshop-ticker

# --- Sandbox (defaults are fine) --------------------------------------------
# A random suffix is added (e.g. relaxai-workshop-3fa9c2), so every sandbox
# has its own name.
sandbox_name=relaxai-workshop
sandbox_template=cloud-runtime-template
cpu=2
memory=4Gi
storage=5Gi
sandbox_timeout=4h
# Egress allowlist for the "limited" policy. Leave empty for the default:
#   <endpoint>, github.com, api.github.com, codeload.github.com,
#   objects.githubusercontent.com, raw.githubusercontent.com, registry.npmjs.org
# Every other host is denied, including other package registries. Setting this
# replaces the default list, so include everything you still need.
allowed_hosts=

# --- Agent -------------------------------------------------------------------
claude_code_version=2.1.146
# Seconds before a review session is killed.
claude_run_timeout=600
