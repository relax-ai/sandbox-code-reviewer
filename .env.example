# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Source it with:   set -a; . ./.env; set +a

# -----------------------------------------------------------------------------
# Relax (sandboxes API + model backend)
# -----------------------------------------------------------------------------
# Sandboxes API host (no scheme, no path).
endpoint=api.beta.relax.ai

# Relax API key. Authenticates against the sandboxes API (Authorization: Bearer)
# AND is injected into the sandbox as ANTHROPIC_API_KEY so the agent can call
# https://$endpoint/v1. One key covers both.
api_key=

# -----------------------------------------------------------------------------
# Sandbox
# -----------------------------------------------------------------------------
sandbox_name=relaxai-pr-review
sandbox_template=cloud-runtime-template
cpu=2
memory=4Gi
storage=5Gi

# Networking policy: "unrestricted" (allow all egress) or "limited" (restrict
# egress to allowed_hosts — the containment story: the sandbox can then only
# reach the hosts below, so untrusted PR code can't exfiltrate anywhere).
networking_type=limited
# The list below is only used when networking_type=limited.
# Comma-separated, no spaces. Must include everything the run needs:
#   - api.beta.relax.ai   the model backend (Anthropic-compatible /v1/messages)
#   - cli.github.com      gh CLI apt source (Ubuntu 22.04 has no gh package)
#   - registry.npmjs.org  npm install of the agent runtime
#   - api.github.com / github.com / codeload.github.com  list PRs, clone, comment
# allow_package_managers is enabled for apt/npm mirrors automatically.
allowed_hosts=api.beta.relax.ai,cli.github.com,registry.npmjs.org,api.github.com,github.com,codeload.github.com,raw.githubusercontent.com,objects.githubusercontent.com

# Sandbox lifetime (e.g. 2h, 4h, 30m). Empty = persist until ./destroy.sh.
sandbox_timeout=4h

# -----------------------------------------------------------------------------
# Claude Code
# -----------------------------------------------------------------------------
claude_code_version=2.1.146   # npm version: @anthropic-ai/claude-code@<ver>
claude_run_timeout=300        # seconds before the review session is killed

# Model id served by the Relax API. The base URL is derived from `endpoint`
# above (https://$endpoint), so the model is always on the same host.
model_id=DeepSeek-V41-Flash
api_timeout_ms=300000

# -----------------------------------------------------------------------------
# PR review demo
# -----------------------------------------------------------------------------
# GitHub PAT (fine-grained recommended): pull-requests read+write on the target
# repo. Injected as GH_TOKEN; the agent's gh CLI uses it to list PRs and post
# reviews.
github_token=
# Repo the agent will review, in owner/repo form.
target_repo=

# 1 = agent prints the review it would post (safe for rehearsals).
# 0 = posts live to GitHub.
dry_run=1
